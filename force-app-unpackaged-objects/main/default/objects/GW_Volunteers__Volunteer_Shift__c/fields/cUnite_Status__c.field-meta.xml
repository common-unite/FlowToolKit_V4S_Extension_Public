<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>cUnite_Status__c</fullName>
    <externalId>false</externalId>
    <formula>If(GW_Volunteers__Start_Date_Time__c &lt;=  NOW(),&apos;Closed&apos;,
If(GW_Volunteers__Number_of_Volunteers_Still_Needed__c &lt;= 0,
If(
AND(
GW_Volunteers__Volunteer_Job__r.cUnite_Allow_Waitlisting__c,
GW_Volunteers__Total_Volunteers__c &lt; (GW_Volunteers__Desired_Number_of_Volunteers__c + 
BlankValue(GW_Volunteers__Volunteer_Job__r.cUnite_Waitlist_Limit__c,9999))
) 
,&apos;Full/Waitlisting&apos;,&apos;Full&apos;),&apos;Open&apos;))</formula>
    <label>Status</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
