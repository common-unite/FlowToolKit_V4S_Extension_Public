<tr><td style="background:#0b5cab;padding:14px 24px;color:#ffffff;font-size:14px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;">commonUNITE Volunteers &middot; Food Distribution and Nutrition</td></tr>
