<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingGuestRules>
        <fullName>Guest_Volunteer_Campaigns</fullName>
        <accessLevel>Read</accessLevel>
        <description>Volunteer Job and Shift are master-detail to Campaign, so the Job Finder shows a guest nothing without this. Demo scaffolding only: the site developer name is scratch-org specific. Read documents/security/campaign-sharing-guest-pii-summary.md before widening it.</description>
        <label>Guest Volunteer Campaigns</label>
        <sharedTo>
            <guestUser>Volunteer_Portal</guestUser>
        </sharedTo>
        <criteriaItems>
            <field>IsActive</field>
            <operation>equals</operation>
            <value>true</value>
        </criteriaItems>
    </sharingGuestRules>
</SharingRules>
