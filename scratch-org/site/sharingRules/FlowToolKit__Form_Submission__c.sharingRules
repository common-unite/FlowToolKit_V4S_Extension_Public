<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingGuestRules>
        <fullName>Guest_Prefill_Templates_Volunteer_Portal</fullName>
        <accessLevel>Read</accessLevel>
        <description>Lets the Volunteer Portal guest read pre-fill template submissions; a form with a pre-fill template fails for a guest without it. Dev org scaffolding only (issue #50), never package source.</description>
        <label>Guest Prefill Templates Volunteer Portal</label>
        <sharedTo>
            <guestUser>Volunteer_Portal</guestUser>
        </sharedTo>
        <criteriaItems>
            <field>FlowToolKit__IsPrefillTemplate__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <includeHVUOwnedRecords>false</includeHVUOwnedRecords>
    </sharingGuestRules>
    <sharingGuestRules>
        <fullName>Guest_Prefill_Templates_LWR_Portal</fullName>
        <accessLevel>Read</accessLevel>
        <description>Lets the LWR Volunteer Portal guest read pre-fill template submissions; a form with a pre-fill template fails for a guest without it. Dev org scaffolding only (issue #50), never package source.</description>
        <label>Guest Prefill Templates LWR Portal</label>
        <sharedTo>
            <guestUser>LWR_Volunteer_Portal</guestUser>
        </sharedTo>
        <criteriaItems>
            <field>FlowToolKit__IsPrefillTemplate__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <includeHVUOwnedRecords>false</includeHVUOwnedRecords>
    </sharingGuestRules>
</SharingRules>
